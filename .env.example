# ============================================================================
# Copy to .env.local for development. Never commit .env.local.
# In production these live in the Vercel project's Environment Variables.
# ============================================================================

# --- Supabase -----------------------------------------------------------
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely — used for admin actions such as
# approving a payment. Must NEVER be prefixed NEXT_PUBLIC_, and must never
# appear in a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Billing (manual, WhatsApp + bank/cash) -----------------------------
# International format, no + or spaces. Used to build wa.me links.
NEXT_PUBLIC_WHATSAPP_NUMBER=212600000000

# Shown to students on the subscription page.
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_HOLDER=
NEXT_PUBLIC_BANK_RIB=
NEXT_PUBLIC_CASHPLUS_NUMBER=
