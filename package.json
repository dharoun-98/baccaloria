{
  "name": "baccaloria",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme de préparation au Baccalauréat marocain — PC, SE, SGC",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:validate": "node scripts/validate-schema.mjs",
    "db:bundle": "node scripts/bundle-sql.mjs",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --linked > src/lib/supabase/database.types.ts",
    "db:seed": "supabase db reset --linked"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@11.5.3",
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "katex": "^0.18.4",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "nanoid": "^6.0.1",
    "next": "^16.3.0",
    "next-intl": "^4.13.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "pdfjs-dist": "^6.2.108",
    "supabase": "^2.114.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
